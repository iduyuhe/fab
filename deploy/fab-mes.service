[Unit]
Description=fab-mes AI-native smart manufacturing platform (晶圆厂AI原生的智能制造平台)
After=network.target

[Service]
CPUQuota=200%
WorkingDirectory=/opt/fab-mes
Environment=NODE=/opt/node22/bin/node
Environment=APC_ENABLED=1
Environment=ADAPTER_MODE=all
Environment=APS_RECOMPUTE_MS=5000
# 自动化总开关【启动必关】（用户红线：演示系统部署/重启绝不自己跑）。
# FAB_AUTOMATION=1 仅作"本次启动默认开"的临时手段；不设或=0 即启动即演示闲置。
# 运行时人工开/关：POST /api/admin/automation {"enabled":true|false}（门户主数据台有按钮）。
Environment=FAB_AUTOMATION=0
Environment=PORT=8204
Environment=MES_PORT=8204
Environment=PORTAL_PORT=8203
Environment=EAP_PORT=8205
Environment=ERP_PORT=8206
Environment=AGENT_PORT=8207
Environment=WMS_PORT=8208
Environment=HSMS_PORT=8200
Environment=MES_WS=ws://127.0.0.1:8204
Environment=MES_HTTP=http://127.0.0.1:8204
Environment=ERP_HTTP=http://127.0.0.1:8206
Environment=LDA_WATCHER=1
Environment=LDA_BASE=http://127.0.0.1:3006
Environment=LDA_WATCH_MS=20000
Environment=LDA_WATCH_BURST=5
ExecStart=/bin/bash /opt/fab-mes/bin/start-community.sh
Restart=on-failure
RestartSec=5
User=root
StandardOutput=journald
StandardError=journald

[Install]
WantedBy=multi-user.target
